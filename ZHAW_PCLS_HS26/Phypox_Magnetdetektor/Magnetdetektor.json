        "name": "Magnitude",
        "func": "var magX = msg.payload.MagX;\nvar magY = msg.payload.MagY;\nvar magZ = msg.payload.MagZ;\n\nvar magnitude = Math.sqrt((magX*magX)+(magY*magY)+(magZ*magZ));\n\n// Punkt fuer den Chart: Linie, Zeit, Wert\nmsg.payload = { series: 'Magnitude', x: Date.now(), y: magnitude };\n\nreturn msg;",
