    {
        "id": "a7b8c9d0e1f20001",
        "type": "ui-template",
        "z": "d321589ef9b5426e",
        "group": "448d39c77cb18c4c",
        "page": "",
        "ui": "",
        "name": "Metalldetektor Ton",
        "order": 2,
        "width": 8,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div style=\"display:flex; align-items:center; gap:16px; flex-wrap:wrap;\">\n    <v-btn :color=\"running ? 'red' : 'primary'\" @click=\"toggle\">\n      {{ running ? 'Ton aus' : 'Ton an' }}\n    </v-btn>\n    <span>{{ wert }} µT | Basis {{ basisAnzeige }} µT | Ausschlag {{ ausschlag }} µT → {{ frequenz }} Hz</span>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () {\n    return {\n      // ===== Einstellungen =====\n      RAUSCHEN: 20,          // Ausschlag unter diesem Wert = Ruhe (µT)\n      AUSSCHLAG_MAX: 2000,  // ab diesem Ausschlag: höchster und lautester Ton (µT)\n      BASIS_ZEIT: 0,        // Sekunden Verlauf für die Basis; ein Metall direkt am Handy wird nach ca. der Hälfte zur neuen Basis (0 = feste Basis)\n      BASIS_FEST: 40,       // nur wenn BASIS_ZEIT = 0: feste Basis (µT)\n      TON_MIN: 150,         // Ton in Ruhe (Hz)\n      TON_MAX: 1000,        // Ton beim stärksten Ausschlag (Hz)\n      LEISE: 0.06,          // Lautstärke in Ruhe (0 bis 1)\n      LAUT: 0.3,            // Lautstärke beim stärksten Ausschlag (0 bis 1)\n      TREMOLO: true,        // Ton pulsiert schneller, je stärker der Ausschlag\n      TREMOLO_MAX: 15,      // Pulse pro Sekunde beim stärksten Ausschlag\n      WELLENFORM: 'sine', // 'square' = brummig wie Detektor, 'sine' = weich\n      STILLE_NACH: 1000,    // ms ohne neue Daten, dann Ton stumm\n      // ===== Anzeige =====\n      running: false,\n      wert: '–',\n      basisAnzeige: '–',\n      ausschlag: '–',\n      frequenz: '–'\n    }\n  },\n  watch: {\n    msg: function () {\n      if (this.msg) this.neueWerte(this.msg.payload)\n    }\n  },\n  methods: {\n    toggle () {\n      if (this.running) {\n        this.stopTon()\n      } else {\n        this.startTon()\n      }\n    },\n    startTon () {\n      // Browser erlauben Ton erst nach einem Klick, darum Start per Knopf\n      const ctx = new (window.AudioContext || window.webkitAudioContext)()\n      // Klangkette: Oszillator -> Filter (macht den Ton weicher) -> Lautstärke -> Lautsprecher\n      const osc = ctx.createOscillator()\n      osc.type = this.WELLENFORM\n      osc.frequency.value = this.TON_MIN\n      const filter = ctx.createBiquadFilter()\n      filter.type = 'lowpass'\n      filter.frequency.value = this.TON_MIN * 3\n      filter.Q.value = 1\n      const amp = ctx.createGain()\n      amp.gain.value = 0\n      osc.connect(filter)\n      filter.connect(amp)\n      amp.connect(ctx.destination)\n      // Tremolo: ein langsamer Oszillator lässt die Lautstärke pulsieren\n      const lfo = ctx.createOscillator()\n      lfo.type = 'sine'\n      lfo.frequency.value = 0.1\n      const lfoTiefe = ctx.createGain()\n      lfoTiefe.gain.value = 0\n      lfo.connect(lfoTiefe)\n      lfoTiefe.connect(amp.gain)\n      osc.start()\n      lfo.start()\n      this.audio = { ctx, osc, filter, amp, lfo, lfoTiefe }\n      this.running = true\n    },\n    stopTon () {\n      clearTimeout(this.stilleTimer)\n      if (this.audio) {\n        this.audio.osc.stop()\n        this.audio.lfo.stop()\n        this.audio.ctx.close()\n      }\n      this.audio = null\n      this.running = false\n    },\n    neueWerte (payload) {\n      // akzeptiert: Zahl, {y: Zahl} oder Liste davon\n      const liste = Array.isArray(payload) ? payload : [payload]\n      let staerkster = 0\n      let letzter = null\n      for (const p of liste) {\n        const v = Number(p && typeof p === 'object' ? p.y : p)\n        if (!Number.isFinite(v)) continue\n        // Basis = Median der letzten BASIS_ZEIT Sekunden (Erdmagnetfeld, Handy-Lage)\n        // Der Median ignoriert kurze Peaks, folgt aber dauerhaften Änderungen\n        if (this.BASIS_ZEIT > 0) {\n          if (!this.verlauf) this.verlauf = []\n          this.verlauf.push(v)\n          const n = Math.max(1, Math.round(this.BASIS_ZEIT * 20))\n          if (this.verlauf.length > n) this.verlauf.splice(0, this.verlauf.length - n)\n          const sortiert = this.verlauf.slice().sort((a, b) => a - b)\n          this.basis = sortiert[Math.floor(sortiert.length / 2)]\n        } else {\n          this.basis = this.BASIS_FEST\n        }\n        // Peak im Paket merken\n        staerkster = Math.max(staerkster, Math.abs(v - this.basis))\n        letzter = v\n      }\n      if (letzter === null) return\n\n      // Ausschlag in Anteil 0 bis 1 umrechnen (logarithmisch)\n      let anteil = 0\n      if (staerkster > this.RAUSCHEN) {\n        anteil = Math.log(staerkster / this.RAUSCHEN) / Math.log(this.AUSSCHLAG_MAX / this.RAUSCHEN)\n        anteil = Math.min(Math.max(anteil, 0), 1)\n      }\n      const f = this.TON_MIN + anteil * (this.TON_MAX - this.TON_MIN)\n      const lautst = this.LEISE + Math.pow(anteil, 0.7) * (this.LAUT - this.LEISE)\n\n      this.wert = letzter.toFixed(1)\n      this.basisAnzeige = this.basis.toFixed(1)\n      this.ausschlag = staerkster.toFixed(1)\n      this.frequenz = Math.round(f)\n\n      if (!this.running || !this.audio) return\n      const au = this.audio\n      const t = au.ctx.currentTime\n      // schnell lauter/höher, langsamer wieder zurück (wie beim Detektor)\n      const tau = anteil > this.letzterAnteil ? 0.03 : 0.2\n      this.letzterAnteil = anteil\n      au.osc.frequency.setTargetAtTime(f, t, tau)\n      au.filter.frequency.setTargetAtTime(f * 3, t, tau)\n      au.amp.gain.setTargetAtTime(lautst, t, tau)\n      if (this.TREMOLO) {\n        au.lfo.frequency.setTargetAtTime(0.1 + anteil * this.TREMOLO_MAX, t, tau)\n        au.lfoTiefe.gain.setTargetAtTime(lautst * 0.5 * anteil, t, tau)\n      }\n\n      // kommen keine Daten mehr, Ton ausblenden\n      clearTimeout(this.stilleTimer)\n      this.stilleTimer = setTimeout(() => {\n        if (this.audio) {\n          const t2 = this.audio.ctx.currentTime\n          this.audio.amp.gain.setTargetAtTime(0, t2, 0.05)\n          this.audio.lfoTiefe.gain.setTargetAtTime(0, t2, 0.05)\n        }\n      }, this.STILLE_NACH)\n    }\n  },\n  unmounted () {\n    this.stopTon()\n  }\n}\n</script>",
