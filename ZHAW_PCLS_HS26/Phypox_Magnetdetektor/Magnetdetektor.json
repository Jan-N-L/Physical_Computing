    {
        "id": "b7c1a0d2e3f40002",
        "type": "function",
        "z": "d321589ef9b5426e",
        "name": "Verzögerung messen",
        "func": "const now = Date.now() / 1000;\nconst ts = Number(msg.payload && msg.payload.Timestamp);\nif (!Number.isFinite(ts)) {\n  node.status({fill: 'yellow', shape: 'ring', text: 'kein gültiger Timestamp: ' + JSON.stringify(msg.payload).slice(0, 60)});\n  return null;\n}\nconst last = context.get('lastTs');\nlet minOff = context.get('minOff');\nif (last === undefined || ts < last || !Number.isFinite(minOff)) {\n  minOff = now - ts;\n  context.set('count', 0);\n  context.set('winStart', now);\n}\ncontext.set('lastTs', ts);\nconst off = now - ts;\nminOff = Math.min(minOff, off);\ncontext.set('minOff', minOff);\nconst lag = off - minOff;\nlet count = (context.get('count') || 0) + 1;\nlet winStart = context.get('winStart') || now;\nif (now - winStart >= 1) {\n  node.status({fill: lag > 0.5 ? 'red' : 'green', shape: 'dot', text: 'Verzögerung ' + lag.toFixed(2) + ' s | ' + count + ' Nachr./s'});\n  count = 0;\n  winStart = now;\n}\ncontext.set('count', count);\ncontext.set('winStart', winStart);\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
